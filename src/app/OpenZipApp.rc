// OpenZipApp.rc — dialog templates, string tables, version info.

#include "winres.h"
#include "resource.h"

/////////////////////////////////////////////////////////////////////////////
// App icon — picked up by CDialogEx via AfxGetApp()->LoadIcon(IDR_MAINFRAME)
// for the dialog title bar + taskbar.
/////////////////////////////////////////////////////////////////////////////

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDR_MAINFRAME           ICON                    "icon.ico"

/////////////////////////////////////////////////////////////////////////////
// Dialog templates (LANG_NEUTRAL — used as base; per-language strings come
// from the STRINGTABLE blocks below and are applied in OnInitDialog).
/////////////////////////////////////////////////////////////////////////////

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

// Minimal dialog system — common rules:
//   * 16 dlu outer margin
//   * 12 dlu vertical row gap
//   * No GROUPBOX chrome — whitespace + inline labels carry grouping
//   * Action buttons: right-aligned, 60×16 dlu, OK before Cancel (Win11 convention)
//   * "Heading + value" label pairs collapsed to value-only where context is clear

IDD_ARCHIVE_BROWSER DIALOGEX 0, 0, 760, 400
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX | WS_MINIMIZEBOX
CAPTION "OpenZip"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_BROWSE_ZIPPATH, 16, 14, 728, 12, SS_NOPREFIX | SS_PATHELLIPSIS
    CONTROL         "", IDC_BROWSE_LIST, "SysListView32",
                    LVS_REPORT | LVS_SHOWSELALWAYS | WS_TABSTOP,
                    16, 32, 728, 336
    DEFPUSHBUTTON   "Extract All", IDC_BROWSE_EXTRACT_ALL, 604, 378, 70, 16
    PUSHBUTTON      "Close",       IDCANCEL,               684, 378, 60, 16
END

IDD_COMPRESS_OPTIONS DIALOGEX 0, 0, 360, 224
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "OpenZip"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    // Output filename
    LTEXT           "Output name", IDC_LABEL_COMPRESS_OUTNAME, 16, 16, 80, 10
    EDITTEXT        IDC_COMPRESS_OUTNAME, 16, 28, 328, 14, ES_AUTOHSCROLL

    // Output folder + browse
    LTEXT           "Output folder", IDC_LABEL_COMPRESS_OUTDIR, 16, 50, 80, 10
    EDITTEXT        IDC_COMPRESS_OUTDIR,  16, 62, 280, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "...",                IDC_COMPRESS_BROWSE, 304, 62, 40, 14

    // Compression level — single inline row, no group box
    LTEXT           "Compression",    IDC_GROUP_COMPRESS_LEVEL, 16, 88, 80, 10
    AUTORADIOBUTTON "Store",  IDC_COMPRESS_LEVEL_STORE,   16, 102, 60, 12, WS_GROUP
    AUTORADIOBUTTON "Fast",   IDC_COMPRESS_LEVEL_FAST,    80, 102, 60, 12
    AUTORADIOBUTTON "Normal", IDC_COMPRESS_LEVEL_NORMAL, 144, 102, 60, 12
    AUTORADIOBUTTON "Max",    IDC_COMPRESS_LEVEL_MAX,    208, 102, 60, 12

    // Password (single block — show checkbox sits with the inputs)
    LTEXT           "Password (optional, empty = no encryption)",
                    IDC_LABEL_COMPRESS_PASSWORD, 16, 128, 280, 10
    EDITTEXT        IDC_COMPRESS_PASSWORD,     16, 140, 328, 14, ES_PASSWORD | ES_AUTOHSCROLL
    EDITTEXT        IDC_COMPRESS_PASSWORD_CFM, 16, 158, 328, 14, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "Re-enter password", IDC_LABEL_COMPRESS_PASSWORD_CFM, 16, 176, 120, 10
    AUTOCHECKBOX    "Show", IDC_COMPRESS_SHOW_PW, 280, 176, 64, 12

    // Action buttons — right-aligned
    DEFPUSHBUTTON   "OK",     IDOK,     220, 198, 60, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 284, 198, 60, 16
END

IDD_COMPRESS DIALOGEX 0, 0, 360, 130
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "OpenZip"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT   "Ready...", IDC_COMPRESS_CURRENT, 16, 18, 328, 24, SS_NOPREFIX | SS_PATHELLIPSIS
    CONTROL "",         IDC_COMPRESS_PROGRESS, "msctls_progress32",
                        PBS_SMOOTH | WS_BORDER, 16, 60, 328, 12
    LTEXT   "",         IDC_COMPRESS_QUEUE, 16, 80, 200, 12
    PUSHBUTTON "Cancel", IDC_COMPRESS_CANCEL, 284, 104, 60, 16
END

IDD_EXTRACT DIALOGEX 0, 0, 360, 116
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "OpenZip"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    // Heading labels collapsed — value text alone carries the meaning.
    // The two LABEL_HEADING controls are kept (for backward compatibility with
    // ExtractDialog.cpp's SetDlgItemText calls) but moved off-screen.
    LTEXT           "", IDC_LABEL_ARCHIVE_HEADING, -100, -100, 8, 8, NOT WS_VISIBLE
    LTEXT           "", IDC_LABEL_CURRENT_HEADING, -100, -100, 8, 8, NOT WS_VISIBLE

    LTEXT           "", IDC_LABEL_ARCHIVE,      16, 14, 328, 10, SS_PATHELLIPSIS
    LTEXT           "", IDC_LABEL_CURRENT_FILE, 16, 28, 328, 10, SS_PATHELLIPSIS

    CONTROL         "", IDC_PROGRESS_OVERALL, "msctls_progress32",
                        PBS_SMOOTH | WS_BORDER, 16, 50, 328, 12

    LTEXT           "0%", IDC_LABEL_PERCENT, 16, 68, 60, 10
    LTEXT           "",   IDC_LABEL_COUNT,  130, 68, 100, 10, SS_CENTER
    LTEXT           "",   IDC_LABEL_SPEED,  240, 68, 104, 10, SS_RIGHT

    DEFPUSHBUTTON   "Cancel", IDCANCEL, 284, 90, 60, 16
END

IDD_PASSWORD DIALOGEX 0, 0, 300, 110
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Password Required"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    // The encryption-context prompt (e.g. "Archive 'foo.zip' is password-protected.")
    // is the only heading — Enter Password label is dropped (cue is obvious).
    LTEXT           "", IDC_LABEL_PASSWORD_PROMPT, 16, 16, 268, 24
    // Hidden no-op kept so ExtractDialog.cpp's SetDlgItemText still finds it.
    LTEXT           "", IDC_LABEL_PASSWORD_ENTER,  -100, -100, 8, 8, NOT WS_VISIBLE
    EDITTEXT        IDC_EDIT_PASSWORD, 16, 50, 268, 14, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "", IDC_LABEL_PASSWORD_HINT,   16, 70, 268, 10
    DEFPUSHBUTTON   "OK",     IDOK,     164, 88, 60, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 228, 88, 60, 16
END

IDD_DROP_TARGET DIALOGEX 0, 0, 320, 160
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX
EXSTYLE WS_EX_ACCEPTFILES
CAPTION "OpenZip"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_DROP_HINT, 16, 64, 288, 32,
                    SS_CENTER | SS_NOPREFIX
END

IDD_CONFLICT DIALOGEX 0, 0, 360, 124
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "File Already Exists"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_LABEL_CONFLICT_HEADING, 16, 16, 328, 10
    LTEXT           "", IDC_LABEL_CONFLICT_PATH,    16, 30, 328, 20, SS_PATHELLIPSIS
    AUTOCHECKBOX    "", IDC_CHECK_REMEMBER,         16, 60, 328, 12

    // Right-aligned action row. Skip is the safe default (per spec §3 #7).
    PUSHBUTTON      "Overwrite", IDC_BTN_OVERWRITE, 88,  98, 60, 18
    DEFPUSHBUTTON   "Skip",      IDC_BTN_SKIP,      152, 98, 60, 18
    PUSHBUTTON      "Rename",    IDC_BTN_RENAME,    216, 98, 60, 18
    PUSHBUTTON      "Cancel",    IDCANCEL,          280, 98, 60, 18
END

/////////////////////////////////////////////////////////////////////////////
// English (default) string table
/////////////////////////////////////////////////////////////////////////////

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(65001)  // UTF-8

STRINGTABLE
BEGIN
    IDS_DIALOG_EXTRACT_TITLE     "OpenZip"
    IDS_DIALOG_PASSWORD_TITLE    "Password Required"
    IDS_DIALOG_CONFLICT_TITLE    "File Already Exists"

    IDS_LABEL_ARCHIVE            "Archive:"
    IDS_LABEL_CURRENT            "Current:"
    IDS_LABEL_PASSWORD_ENTER     "Enter password:"
    IDS_LABEL_PASSWORD_ENC_FOR   "Archive '%s' is password-protected."
    IDS_LABEL_PASSWORD_ENC_ENTRY "'%s' inside '%s' is encrypted."
    IDS_LABEL_PASSWORD_HINT_WRONG "Wrong password. Try again or cancel."
    IDS_LABEL_CONFLICT           "This file already exists:"
    IDS_CHECK_REMEMBER           "Apply this choice to all remaining conflicts in this archive"
    IDS_LABEL_CANCELLING         "Cancelling..."

    IDS_BUTTON_CANCEL            "Cancel"
    IDS_BUTTON_OK                "OK"
    IDS_BUTTON_OVERWRITE         "Overwrite"
    IDS_BUTTON_SKIP              "Skip"
    IDS_BUTTON_RENAME            "Rename"

    IDS_HELP_TITLE               "OpenZip"
    IDS_ERROR_TITLE              "OpenZip"
    IDS_HELP_TEXT                "OpenZip 0.4.0 — usage:\n\n  openzip.exe [--extract] <archive> [options]\n  openzip.exe --compress --output <archive> [--mode bundle|each|prompt] --item <path>...\n\nSupported formats: .zip, .gz / .tar.gz / .tgz, .xz / .tar.xz / .txz (single-stream gzip and xz)\n\nExtract options:\n  --target <dir>   explicit output directory\n  --here           extract into the archive's parent directory\n  --folder         extract into a new subfolder named after the archive (default for .zip)\n  --password <pw>  pre-supply the password for encrypted archives\n  --threads <n>    override extraction parallelism (0 = auto, 1 = legacy serial)\n\nCompress options:\n  --output <path>  output archive path; .gz / .xz suffix produces a single-stream archive (one file only)\n  --mode           bundle (default), each, or prompt\n  --level          store, fast, normal (default), or max\n  --encoding       utf8 (default) or cp949\n  --item <path>    source file or folder (repeatable)"

    IDS_DIALOG_COMPRESS_OPT_TITLE   "OpenZip — Compress Options"
    IDS_DIALOG_COMPRESS_TITLE       "OpenZip — Compress"
    IDS_LABEL_COMPRESS_OUTNAME      "Output name"
    IDS_LABEL_COMPRESS_OUTDIR       "Output dir"
    IDS_GROUP_COMPRESS_LEVEL        "Level"
    IDS_RADIO_COMPRESS_LEVEL_STORE  "Store"
    IDS_RADIO_COMPRESS_LEVEL_FAST   "Fast"
    IDS_RADIO_COMPRESS_LEVEL_NORMAL "Normal"
    IDS_RADIO_COMPRESS_LEVEL_MAX    "Max"
    IDS_LABEL_COMPRESS_PASSWORD     "Password (optional)"
    IDS_LABEL_COMPRESS_PASSWORD_CFM "Confirm"
    IDS_CHECK_COMPRESS_SHOW_PW      "Show"
    IDS_LABEL_COMPRESS_READY        "Ready..."

    IDS_DIALOG_BROWSE_TITLE         "OpenZip — Archive Contents"
    IDS_LABEL_BROWSE_NAME           "Name"
    IDS_LABEL_BROWSE_SIZE           "Original Size"
    IDS_LABEL_BROWSE_PACKED         "Packed"
    IDS_LABEL_BROWSE_MODIFIED       "Modified"
    IDS_LABEL_BROWSE_CREATED        "Created"
    IDS_BUTTON_EXTRACT_ALL          "Extract All"
    IDS_BUTTON_EXTRACT_SELECTED     "Extract"
    IDS_BUTTON_CLOSE                "Close"
    IDS_PICK_DESTINATION            "Choose destination folder"

    IDS_DROP_TARGET_TITLE           "OpenZip"
    IDS_DROP_TARGET_HINT            "Drop archive files here\n(.zip / .gz / .tar.gz / .xz / .tar.xz)"
END

/////////////////////////////////////////////////////////////////////////////
// Korean string table
/////////////////////////////////////////////////////////////////////////////

LANGUAGE LANG_KOREAN, SUBLANG_KOREAN
#pragma code_page(65001)  // UTF-8

STRINGTABLE
BEGIN
    IDS_DIALOG_EXTRACT_TITLE     "OpenZip"
    IDS_DIALOG_PASSWORD_TITLE    "비밀번호 필요"
    IDS_DIALOG_CONFLICT_TITLE    "파일이 이미 존재합니다"

    IDS_LABEL_ARCHIVE            "압축 파일:"
    IDS_LABEL_CURRENT            "현재 파일:"
    IDS_LABEL_PASSWORD_ENTER     "비밀번호 입력:"
    IDS_LABEL_PASSWORD_ENC_FOR   "'%s' 아카이브에 비밀번호가 설정되어 있습니다."
    IDS_LABEL_PASSWORD_ENC_ENTRY "'%s' 안의 '%s' 파일이 암호화되어 있습니다."
    IDS_LABEL_PASSWORD_HINT_WRONG "비밀번호가 틀렸습니다. 다시 시도하거나 취소하세요."
    IDS_LABEL_CONFLICT           "이 파일이 이미 존재합니다:"
    IDS_CHECK_REMEMBER           "이 아카이브의 남은 모든 충돌에 같은 선택 적용"
    IDS_LABEL_CANCELLING         "취소 중..."

    IDS_BUTTON_CANCEL            "취소"
    IDS_BUTTON_OK                "확인"
    IDS_BUTTON_OVERWRITE         "덮어쓰기"
    IDS_BUTTON_SKIP              "건너뛰기"
    IDS_BUTTON_RENAME            "이름 변경"

    IDS_HELP_TITLE               "OpenZip"
    IDS_ERROR_TITLE              "OpenZip"
    IDS_HELP_TEXT                "OpenZip 0.4.0 — 사용법:\n\n  openzip.exe [--extract] <아카이브> [옵션]\n  openzip.exe --compress --output <아카이브> [--mode bundle|each|prompt] --item <path>...\n\n지원 형식: .zip, .gz / .tar.gz / .tgz, .xz / .tar.xz / .txz (gzip·xz 단일 스트림)\n\n압축 해제 옵션:\n  --target <dir>   출력 폴더 지정\n  --here           아카이브의 상위 폴더에 풀기\n  --folder         아카이브 이름의 새 폴더에 풀기 (.zip 기본값)\n  --password <pw>  암호화된 아카이브 비밀번호 사전 지정\n  --threads <n>    추출 병렬도 지정 (0 = 자동, 1 = 단일 스레드)\n\n압축 옵션:\n  --output <path>  출력 경로 (.gz / .xz 확장자는 단일 스트림 아카이브 생성)\n  --mode           bundle (기본), each, 또는 prompt\n  --level          store, fast, normal (기본), 또는 max\n  --encoding       utf8 (기본) 또는 cp949\n  --item <path>    원본 파일 또는 폴더 (반복 지정 가능)"

    IDS_DIALOG_COMPRESS_OPT_TITLE   "OpenZip — 압축 옵션"
    IDS_DIALOG_COMPRESS_TITLE       "OpenZip — 압축"
    IDS_LABEL_COMPRESS_OUTNAME      "출력 파일명"
    IDS_LABEL_COMPRESS_OUTDIR       "출력 위치"
    IDS_GROUP_COMPRESS_LEVEL        "압축률"
    IDS_RADIO_COMPRESS_LEVEL_STORE  "저장"
    IDS_RADIO_COMPRESS_LEVEL_FAST   "빠름"
    IDS_RADIO_COMPRESS_LEVEL_NORMAL "보통"
    IDS_RADIO_COMPRESS_LEVEL_MAX    "최대"
    IDS_LABEL_COMPRESS_PASSWORD     "비밀번호 (선택)"
    IDS_LABEL_COMPRESS_PASSWORD_CFM "다시 입력"
    IDS_CHECK_COMPRESS_SHOW_PW      "표시"
    IDS_LABEL_COMPRESS_READY        "준비 중..."

    IDS_DIALOG_BROWSE_TITLE         "OpenZip — 압축 파일 내용"
    IDS_LABEL_BROWSE_NAME           "이름"
    IDS_LABEL_BROWSE_SIZE           "원본 크기"
    IDS_LABEL_BROWSE_PACKED         "압축 후"
    IDS_LABEL_BROWSE_MODIFIED       "수정한 날짜"
    IDS_LABEL_BROWSE_CREATED        "생성한 날짜"
    IDS_BUTTON_EXTRACT_ALL          "모두 풀기"
    IDS_BUTTON_EXTRACT_SELECTED     "압축 풀기"
    IDS_BUTTON_CLOSE                "닫기"
    IDS_PICK_DESTINATION            "압축을 풀 폴더 선택"

    IDS_DROP_TARGET_TITLE           "OpenZip"
    IDS_DROP_TARGET_HINT            "여기에 압축 파일을 끌어다 놓으세요\n(.zip / .gz / .tar.gz / .xz / .tar.xz)"
END

/////////////////////////////////////////////////////////////////////////////
// Version info (language-neutral)
/////////////////////////////////////////////////////////////////////////////

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,4,0,0
 PRODUCTVERSION 0,4,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VitalDB"
            VALUE "FileDescription", "OpenZip"
            VALUE "FileVersion", "0.4.0.0"
            VALUE "InternalName", "OpenZipApp"
            VALUE "LegalCopyright", "Copyright (c) 2026 Hyung-Chul Lee / VitalDB"
            VALUE "OriginalFilename", "openzip.exe"
            VALUE "ProductName", "OpenZip"
            VALUE "ProductVersion", "0.4.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
