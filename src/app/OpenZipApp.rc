// OpenZipApp.rc — dialog templates, string tables, version info.

#include "winres.h"
#include "resource.h"

/////////////////////////////////////////////////////////////////////////////
// Dialog templates (LANG_NEUTRAL — used as base; per-language strings come
// from the STRINGTABLE blocks below and are applied in OnInitDialog).
/////////////////////////////////////////////////////////////////////////////

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_EXTRACT DIALOGEX 0, 0, 340, 110
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "OpenZip"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Archive:", IDC_LABEL_ARCHIVE_HEADING, 10, 10, 40, 10
    LTEXT           "", IDC_LABEL_ARCHIVE, 55, 10, 275, 10, SS_PATHELLIPSIS
    LTEXT           "Current:", IDC_LABEL_CURRENT_HEADING, 10, 25, 40, 10
    LTEXT           "", IDC_LABEL_CURRENT_FILE, 55, 25, 275, 10, SS_PATHELLIPSIS
    CONTROL         "", IDC_PROGRESS_OVERALL, "msctls_progress32", PBS_SMOOTH | WS_BORDER, 10, 45, 320, 12
    LTEXT           "0%", IDC_LABEL_PERCENT, 10, 62, 80, 10
    LTEXT           "", IDC_LABEL_COUNT, 100, 62, 100, 10, SS_CENTER
    LTEXT           "", IDC_LABEL_SPEED, 230, 62, 100, 10, SS_RIGHT
    DEFPUSHBUTTON   "Cancel", IDCANCEL, 270, 82, 60, 20
END

IDD_PASSWORD DIALOGEX 0, 0, 260, 95
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Password Required"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_LABEL_PASSWORD_PROMPT, 10, 10, 240, 10
    LTEXT           "Enter password:", IDC_LABEL_PASSWORD_ENTER, 10, 25, 80, 10
    EDITTEXT        IDC_EDIT_PASSWORD, 10, 38, 240, 14, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "", IDC_LABEL_PASSWORD_HINT, 10, 56, 240, 10
    DEFPUSHBUTTON   "OK", IDOK, 145, 72, 50, 18
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 72, 50, 18
END

IDD_CONFLICT DIALOGEX 0, 0, 320, 115
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "File Already Exists"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_LABEL_CONFLICT_HEADING, 10, 10, 300, 10
    LTEXT           "", IDC_LABEL_CONFLICT_PATH, 10, 24, 300, 20, SS_PATHELLIPSIS
    AUTOCHECKBOX    "", IDC_CHECK_REMEMBER, 10, 50, 300, 12
    PUSHBUTTON      "Overwrite", IDC_BTN_OVERWRITE, 10, 75, 65, 22
    DEFPUSHBUTTON   "Skip", IDC_BTN_SKIP, 80, 75, 65, 22
    PUSHBUTTON      "Rename", IDC_BTN_RENAME, 150, 75, 65, 22
    PUSHBUTTON      "Cancel", IDCANCEL, 250, 75, 60, 22
END

/////////////////////////////////////////////////////////////////////////////
// English (default) string table
/////////////////////////////////////////////////////////////////////////////

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(65001)  // UTF-8

STRINGTABLE
BEGIN
    IDS_DIALOG_EXTRACT_TITLE     "OpenZip"
    IDS_DIALOG_PASSWORD_TITLE    "Password Required"
    IDS_DIALOG_CONFLICT_TITLE    "File Already Exists"

    IDS_LABEL_ARCHIVE            "Archive:"
    IDS_LABEL_CURRENT            "Current:"
    IDS_LABEL_PASSWORD_ENTER     "Enter password:"
    IDS_LABEL_PASSWORD_ENC_FOR   "Archive '%s' is password-protected."
    IDS_LABEL_PASSWORD_ENC_ENTRY "'%s' inside '%s' is encrypted."
    IDS_LABEL_PASSWORD_HINT_WRONG "Wrong password. Try again or cancel."
    IDS_LABEL_CONFLICT           "This file already exists:"
    IDS_CHECK_REMEMBER           "Apply this choice to all remaining conflicts in this archive"
    IDS_LABEL_CANCELLING         "Cancelling..."

    IDS_BUTTON_CANCEL            "Cancel"
    IDS_BUTTON_OK                "OK"
    IDS_BUTTON_OVERWRITE         "Overwrite"
    IDS_BUTTON_SKIP              "Skip"
    IDS_BUTTON_RENAME            "Rename"

    IDS_HELP_TITLE               "OpenZip"
    IDS_ERROR_TITLE              "OpenZip"
    IDS_HELP_TEXT                "OpenZip 0.1.0 — usage:\n\n  OpenZipApp.exe [--extract] <zip-path> [options]\n\nOptions:\n  --target <dir>   explicit output directory\n  --here           extract into the zip's parent directory\n  --folder         extract into a new subfolder named after the zip (default)\n  --password <pw>  pre-supply the password for encrypted archives"
END

/////////////////////////////////////////////////////////////////////////////
// Korean string table
/////////////////////////////////////////////////////////////////////////////

LANGUAGE LANG_KOREAN, SUBLANG_KOREAN
#pragma code_page(65001)  // UTF-8

STRINGTABLE
BEGIN
    IDS_DIALOG_EXTRACT_TITLE     "OpenZip"
    IDS_DIALOG_PASSWORD_TITLE    "비밀번호 필요"
    IDS_DIALOG_CONFLICT_TITLE    "파일이 이미 존재합니다"

    IDS_LABEL_ARCHIVE            "압축 파일:"
    IDS_LABEL_CURRENT            "현재 파일:"
    IDS_LABEL_PASSWORD_ENTER     "비밀번호 입력:"
    IDS_LABEL_PASSWORD_ENC_FOR   "'%s' 아카이브에 비밀번호가 설정되어 있습니다."
    IDS_LABEL_PASSWORD_ENC_ENTRY "'%s' 안의 '%s' 파일이 암호화되어 있습니다."
    IDS_LABEL_PASSWORD_HINT_WRONG "비밀번호가 틀렸습니다. 다시 시도하거나 취소하세요."
    IDS_LABEL_CONFLICT           "이 파일이 이미 존재합니다:"
    IDS_CHECK_REMEMBER           "이 아카이브의 남은 모든 충돌에 같은 선택 적용"
    IDS_LABEL_CANCELLING         "취소 중..."

    IDS_BUTTON_CANCEL            "취소"
    IDS_BUTTON_OK                "확인"
    IDS_BUTTON_OVERWRITE         "덮어쓰기"
    IDS_BUTTON_SKIP              "건너뛰기"
    IDS_BUTTON_RENAME            "이름 변경"

    IDS_HELP_TITLE               "OpenZip"
    IDS_ERROR_TITLE              "OpenZip"
    IDS_HELP_TEXT                "OpenZip 0.1.0 — 사용법:\n\n  OpenZipApp.exe [--extract] <zip-path> [옵션]\n\n옵션:\n  --target <dir>   출력 폴더 지정\n  --here           zip 파일의 상위 폴더에 풀기\n  --folder         zip 파일 이름의 새 폴더에 풀기 (기본값)\n  --password <pw>  암호화된 아카이브 비밀번호 사전 지정"
END

/////////////////////////////////////////////////////////////////////////////
// Version info (language-neutral)
/////////////////////////////////////////////////////////////////////////////

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VitalDB"
            VALUE "FileDescription", "OpenZip"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "OpenZipApp"
            VALUE "LegalCopyright", "Copyright (c) 2026 Hyung-Chul Lee / VitalDB"
            VALUE "OriginalFilename", "OpenZipApp.exe"
            VALUE "ProductName", "OpenZip"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
