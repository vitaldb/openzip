// OpenZipApp.rc — dialog templates, string tables, version info.

#include "winres.h"
#include "resource.h"

/////////////////////////////////////////////////////////////////////////////
// Dialog templates (LANG_NEUTRAL — used as base; per-language strings come
// from the STRINGTABLE blocks below and are applied in OnInitDialog).
/////////////////////////////////////////////////////////////////////////////

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_COMPRESS_OPTIONS DIALOGEX 0, 0, 320, 220
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "OpenZip"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Output name",  IDC_LABEL_COMPRESS_OUTNAME, 12, 12, 60, 10
    EDITTEXT        IDC_COMPRESS_OUTNAME, 80, 10, 220, 14, ES_AUTOHSCROLL
    LTEXT           "Output dir",   IDC_LABEL_COMPRESS_OUTDIR, 12, 32, 60, 10
    EDITTEXT        IDC_COMPRESS_OUTDIR, 80, 30, 180, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "...",          IDC_COMPRESS_BROWSE, 264, 30, 36, 14
    GROUPBOX        "Level",        IDC_GROUP_COMPRESS_LEVEL, 12, 56, 296, 36
    AUTORADIOBUTTON "Store",  IDC_COMPRESS_LEVEL_STORE,  20, 70, 50, 12, WS_GROUP
    AUTORADIOBUTTON "Fast",   IDC_COMPRESS_LEVEL_FAST,   80, 70, 50, 12
    AUTORADIOBUTTON "Normal", IDC_COMPRESS_LEVEL_NORMAL, 140, 70, 50, 12
    AUTORADIOBUTTON "Max",    IDC_COMPRESS_LEVEL_MAX,    200, 70, 50, 12
    LTEXT           "Password",     IDC_LABEL_COMPRESS_PASSWORD, 12, 104, 60, 10
    EDITTEXT        IDC_COMPRESS_PASSWORD, 80, 102, 220, 14, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "Confirm",      IDC_LABEL_COMPRESS_PASSWORD_CFM, 12, 124, 60, 10
    EDITTEXT        IDC_COMPRESS_PASSWORD_CFM, 80, 122, 220, 14, ES_PASSWORD | ES_AUTOHSCROLL
    AUTOCHECKBOX    "Show", IDC_COMPRESS_SHOW_PW, 80, 142, 60, 12
    DEFPUSHBUTTON   "OK",     IDOK,     180, 192, 60, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 248, 192, 60, 16
END

IDD_COMPRESS DIALOGEX 0, 0, 320, 130
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "OpenZip"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT   "Ready...", IDC_COMPRESS_CURRENT, 12, 12, 296, 24, SS_NOPREFIX | SS_ENDELLIPSIS
    CONTROL "", IDC_COMPRESS_PROGRESS, "msctls_progress32", WS_BORDER, 12, 50, 296, 14
    LTEXT   "", IDC_COMPRESS_QUEUE, 12, 76, 296, 12
    PUSHBUTTON "Cancel", IDC_COMPRESS_CANCEL, 250, 100, 60, 16
END

IDD_EXTRACT DIALOGEX 0, 0, 340, 110
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "OpenZip"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Archive:", IDC_LABEL_ARCHIVE_HEADING, 10, 10, 40, 10
    LTEXT           "", IDC_LABEL_ARCHIVE, 55, 10, 275, 10, SS_PATHELLIPSIS
    LTEXT           "Current:", IDC_LABEL_CURRENT_HEADING, 10, 25, 40, 10
    LTEXT           "", IDC_LABEL_CURRENT_FILE, 55, 25, 275, 10, SS_PATHELLIPSIS
    CONTROL         "", IDC_PROGRESS_OVERALL, "msctls_progress32", PBS_SMOOTH | WS_BORDER, 10, 45, 320, 12
    LTEXT           "0%", IDC_LABEL_PERCENT, 10, 62, 80, 10
    LTEXT           "", IDC_LABEL_COUNT, 100, 62, 100, 10, SS_CENTER
    LTEXT           "", IDC_LABEL_SPEED, 230, 62, 100, 10, SS_RIGHT
    DEFPUSHBUTTON   "Cancel", IDCANCEL, 270, 82, 60, 20
END

IDD_PASSWORD DIALOGEX 0, 0, 260, 95
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Password Required"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_LABEL_PASSWORD_PROMPT, 10, 10, 240, 10
    LTEXT           "Enter password:", IDC_LABEL_PASSWORD_ENTER, 10, 25, 80, 10
    EDITTEXT        IDC_EDIT_PASSWORD, 10, 38, 240, 14, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "", IDC_LABEL_PASSWORD_HINT, 10, 56, 240, 10
    DEFPUSHBUTTON   "OK", IDOK, 145, 72, 50, 18
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 72, 50, 18
END

IDD_CONFLICT DIALOGEX 0, 0, 320, 115
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "File Already Exists"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_LABEL_CONFLICT_HEADING, 10, 10, 300, 10
    LTEXT           "", IDC_LABEL_CONFLICT_PATH, 10, 24, 300, 20, SS_PATHELLIPSIS
    AUTOCHECKBOX    "", IDC_CHECK_REMEMBER, 10, 50, 300, 12
    PUSHBUTTON      "Overwrite", IDC_BTN_OVERWRITE, 10, 75, 65, 22
    DEFPUSHBUTTON   "Skip", IDC_BTN_SKIP, 80, 75, 65, 22
    PUSHBUTTON      "Rename", IDC_BTN_RENAME, 150, 75, 65, 22
    PUSHBUTTON      "Cancel", IDCANCEL, 250, 75, 60, 22
END

/////////////////////////////////////////////////////////////////////////////
// English (default) string table
/////////////////////////////////////////////////////////////////////////////

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(65001)  // UTF-8

STRINGTABLE
BEGIN
    IDS_DIALOG_EXTRACT_TITLE     "OpenZip"
    IDS_DIALOG_PASSWORD_TITLE    "Password Required"
    IDS_DIALOG_CONFLICT_TITLE    "File Already Exists"

    IDS_LABEL_ARCHIVE            "Archive:"
    IDS_LABEL_CURRENT            "Current:"
    IDS_LABEL_PASSWORD_ENTER     "Enter password:"
    IDS_LABEL_PASSWORD_ENC_FOR   "Archive '%s' is password-protected."
    IDS_LABEL_PASSWORD_ENC_ENTRY "'%s' inside '%s' is encrypted."
    IDS_LABEL_PASSWORD_HINT_WRONG "Wrong password. Try again or cancel."
    IDS_LABEL_CONFLICT           "This file already exists:"
    IDS_CHECK_REMEMBER           "Apply this choice to all remaining conflicts in this archive"
    IDS_LABEL_CANCELLING         "Cancelling..."

    IDS_BUTTON_CANCEL            "Cancel"
    IDS_BUTTON_OK                "OK"
    IDS_BUTTON_OVERWRITE         "Overwrite"
    IDS_BUTTON_SKIP              "Skip"
    IDS_BUTTON_RENAME            "Rename"

    IDS_HELP_TITLE               "OpenZip"
    IDS_ERROR_TITLE              "OpenZip"
    IDS_HELP_TEXT                "OpenZip 0.3.0 — usage:\n\n  OpenZipApp.exe [--extract] <zip-path> [options]\n  OpenZipApp.exe --compress --output <zip> [--mode bundle|each|prompt] --item <path>...\n\nExtract options:\n  --target <dir>   explicit output directory\n  --here           extract into the zip's parent directory\n  --folder         extract into a new subfolder named after the zip (default)\n  --password <pw>  pre-supply the password for encrypted archives\n  --threads <n>    override extraction parallelism (0 = auto, 1 = legacy serial)\n\nCompress options:\n  --output <zip>   output zip path (required for bundle mode)\n  --mode           bundle (default), each, or prompt\n  --level          store, fast, normal (default), or max\n  --encoding       utf8 (default) or cp949\n  --item <path>    source file or folder (repeatable)"

    IDS_DIALOG_COMPRESS_OPT_TITLE   "OpenZip — Compress Options"
    IDS_DIALOG_COMPRESS_TITLE       "OpenZip — Compress"
    IDS_LABEL_COMPRESS_OUTNAME      "Output name"
    IDS_LABEL_COMPRESS_OUTDIR       "Output dir"
    IDS_GROUP_COMPRESS_LEVEL        "Level"
    IDS_RADIO_COMPRESS_LEVEL_STORE  "Store"
    IDS_RADIO_COMPRESS_LEVEL_FAST   "Fast"
    IDS_RADIO_COMPRESS_LEVEL_NORMAL "Normal"
    IDS_RADIO_COMPRESS_LEVEL_MAX    "Max"
    IDS_LABEL_COMPRESS_PASSWORD     "Password (optional)"
    IDS_LABEL_COMPRESS_PASSWORD_CFM "Confirm"
    IDS_CHECK_COMPRESS_SHOW_PW      "Show"
    IDS_LABEL_COMPRESS_READY        "Ready..."
END

/////////////////////////////////////////////////////////////////////////////
// Korean string table
/////////////////////////////////////////////////////////////////////////////

LANGUAGE LANG_KOREAN, SUBLANG_KOREAN
#pragma code_page(65001)  // UTF-8

STRINGTABLE
BEGIN
    IDS_DIALOG_EXTRACT_TITLE     "OpenZip"
    IDS_DIALOG_PASSWORD_TITLE    "비밀번호 필요"
    IDS_DIALOG_CONFLICT_TITLE    "파일이 이미 존재합니다"

    IDS_LABEL_ARCHIVE            "압축 파일:"
    IDS_LABEL_CURRENT            "현재 파일:"
    IDS_LABEL_PASSWORD_ENTER     "비밀번호 입력:"
    IDS_LABEL_PASSWORD_ENC_FOR   "'%s' 아카이브에 비밀번호가 설정되어 있습니다."
    IDS_LABEL_PASSWORD_ENC_ENTRY "'%s' 안의 '%s' 파일이 암호화되어 있습니다."
    IDS_LABEL_PASSWORD_HINT_WRONG "비밀번호가 틀렸습니다. 다시 시도하거나 취소하세요."
    IDS_LABEL_CONFLICT           "이 파일이 이미 존재합니다:"
    IDS_CHECK_REMEMBER           "이 아카이브의 남은 모든 충돌에 같은 선택 적용"
    IDS_LABEL_CANCELLING         "취소 중..."

    IDS_BUTTON_CANCEL            "취소"
    IDS_BUTTON_OK                "확인"
    IDS_BUTTON_OVERWRITE         "덮어쓰기"
    IDS_BUTTON_SKIP              "건너뛰기"
    IDS_BUTTON_RENAME            "이름 변경"

    IDS_HELP_TITLE               "OpenZip"
    IDS_ERROR_TITLE              "OpenZip"
    IDS_HELP_TEXT                "OpenZip 0.3.0 — 사용법:\n\n  OpenZipApp.exe [--extract] <zip-path> [옵션]\n  OpenZipApp.exe --compress --output <zip> [--mode bundle|each|prompt] --item <path>...\n\n압축 해제 옵션:\n  --target <dir>   출력 폴더 지정\n  --here           zip 파일의 상위 폴더에 풀기\n  --folder         zip 파일 이름의 새 폴더에 풀기 (기본값)\n  --password <pw>  암호화된 아카이브 비밀번호 사전 지정\n  --threads <n>    추출 병렬도 지정 (0 = 자동, 1 = 단일 스레드)\n\n압축 옵션:\n  --output <zip>   출력 zip 경로 (bundle 모드 필수)\n  --mode           bundle (기본), each, 또는 prompt\n  --level          store, fast, normal (기본), 또는 max\n  --encoding       utf8 (기본) 또는 cp949\n  --item <path>    원본 파일 또는 폴더 (반복 지정 가능)"

    IDS_DIALOG_COMPRESS_OPT_TITLE   "OpenZip — 압축 옵션"
    IDS_DIALOG_COMPRESS_TITLE       "OpenZip — 압축"
    IDS_LABEL_COMPRESS_OUTNAME      "출력 파일명"
    IDS_LABEL_COMPRESS_OUTDIR       "출력 위치"
    IDS_GROUP_COMPRESS_LEVEL        "압축률"
    IDS_RADIO_COMPRESS_LEVEL_STORE  "저장"
    IDS_RADIO_COMPRESS_LEVEL_FAST   "빠름"
    IDS_RADIO_COMPRESS_LEVEL_NORMAL "보통"
    IDS_RADIO_COMPRESS_LEVEL_MAX    "최대"
    IDS_LABEL_COMPRESS_PASSWORD     "비밀번호 (선택)"
    IDS_LABEL_COMPRESS_PASSWORD_CFM "다시 입력"
    IDS_CHECK_COMPRESS_SHOW_PW      "표시"
    IDS_LABEL_COMPRESS_READY        "준비 중..."
END

/////////////////////////////////////////////////////////////////////////////
// Version info (language-neutral)
/////////////////////////////////////////////////////////////////////////////

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VitalDB"
            VALUE "FileDescription", "OpenZip"
            VALUE "FileVersion", "0.2.0.0"
            VALUE "InternalName", "OpenZipApp"
            VALUE "LegalCopyright", "Copyright (c) 2026 Hyung-Chul Lee / VitalDB"
            VALUE "OriginalFilename", "OpenZipApp.exe"
            VALUE "ProductName", "OpenZip"
            VALUE "ProductVersion", "0.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
