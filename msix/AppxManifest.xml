<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
         xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
         xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
         xmlns:desktop9="http://schemas.microsoft.com/appx/manifest/desktop/windows10/9"
         IgnorableNamespaces="uap uap3 rescap desktop desktop4 desktop5 com desktop9">

  <Identity Name="Hyung-ChulLee.OpenZip"
            Publisher="CN=F654AA56-4E26-4CE5-B9F5-949930D6F0EE"
            Version="0.5.1.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>OpenZip</DisplayName>
    <PublisherDisplayName>Hyung-Chul Lee</PublisherDisplayName>
    <Description>Lightweight ZIP extractor with Explorer context-menu integration</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ko-kr" />
  </Resources>

  <Applications>
    <Application Id="OpenZip"
                 Executable="OpenZipApp.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="OpenZip"
                          Description="Lightweight ZIP extractor"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png"
                          BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"
                         Square71x71Logo="Assets\SmallTile.png"
                         Square310x310Logo="Assets\LargeTile.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- File type association: .zip -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="zipfile">
            <uap:SupportedFileTypes>
              <uap:FileType>.zip</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>ZIP Archive</uap:DisplayName>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- File type association: gzip family (.gz / .tgz / .taz) -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="gzipfile">
            <uap:SupportedFileTypes>
              <uap:FileType>.gz</uap:FileType>
              <uap:FileType>.tgz</uap:FileType>
              <uap:FileType>.taz</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Gzip Archive</uap:DisplayName>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- File type association: xz family (.xz / .txz) -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="xzfile">
            <uap:SupportedFileTypes>
              <uap:FileType>.xz</uap:FileType>
              <uap:FileType>.txz</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>XZ Archive</uap:DisplayName>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- COM server for shell extension -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <!-- Modern shell ext (out-of-process surrogate). Win11 already wraps
                 a package's verbs under the package DisplayName, so we register
                 the leaf verbs directly — no parent flyout — to avoid a second
                 "OpenZip → OpenZip" hop in the modern menu. -->
            <com:SurrogateServer DisplayName="OpenZip Shell Extension">
              <!-- Extract leaves -->
              <com:Class Id="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1A0D"
                         Path="OpenZipShellExt.dll"
                         ThreadingModel="STA" />
              <com:Class Id="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1A0E"
                         Path="OpenZipShellExt.dll"
                         ThreadingModel="STA" />
              <!-- Compress leaves -->
              <com:Class Id="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1B01"
                         Path="OpenZipShellExt.dll"
                         ThreadingModel="STA" />
              <com:Class Id="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1B02"
                         Path="OpenZipShellExt.dll"
                         ThreadingModel="STA" />
              <com:Class Id="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1B03"
                         Path="OpenZipShellExt.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
            <!-- Classic shell ext for Win10 (Phase 5) — registered via surrogate so
                 the CLSID lands in the package's virtual registry; the DLL is loaded
                 in-process by Explorer on Win10 via the desktop9 handler registration -->
            <com:SurrogateServer DisplayName="OpenZip Classic Shell Extension">
              <com:Class Id="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F2000"
                         Path="OpenZipShellExtClassic.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>

        <!-- Modern Win11 context menu verbs. Each verb is a leaf (no parent
             flyout) so the modern menu shows the package's auto-grouped
             "OpenZip" entry only once, with the actual commands directly inside. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <!-- .zip files: extract leaves (compress is provided by the "*" binding) -->
            <desktop5:ItemType Type=".zip">
              <desktop5:Verb Id="OpenZipExtractHere"
                             Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1A0D" />
              <desktop5:Verb Id="OpenZipExtractFolder"
                             Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1A0E" />
            </desktop5:ItemType>
            <!-- gzip family: extract leaves only (gz is single-stream). -->
            <desktop5:ItemType Type=".gz">
              <desktop5:Verb Id="OpenZipExtractHere"
                             Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1A0D" />
              <desktop5:Verb Id="OpenZipExtractFolder"
                             Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1A0E" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".tgz">
              <desktop5:Verb Id="OpenZipExtractHere"
                             Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1A0D" />
              <desktop5:Verb Id="OpenZipExtractFolder"
                             Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1A0E" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".taz">
              <desktop5:Verb Id="OpenZipExtractHere"
                             Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1A0D" />
              <desktop5:Verb Id="OpenZipExtractFolder"
                             Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1A0E" />
            </desktop5:ItemType>
            <!-- xz family: extract leaves only (single-stream). -->
            <desktop5:ItemType Type=".xz">
              <desktop5:Verb Id="OpenZipExtractHere"
                             Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1A0D" />
              <desktop5:Verb Id="OpenZipExtractFolder"
                             Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1A0E" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".txz">
              <desktop5:Verb Id="OpenZipExtractHere"
                             Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1A0D" />
              <desktop5:Verb Id="OpenZipExtractFolder"
                             Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1A0E" />
            </desktop5:ItemType>
            <!-- Any file: compress leaves. GetState hides them when a single
                 archive is selected so extract verbs alone show in that case. -->
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="OpenZipCompressBundle"
                             Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1B01" />
              <desktop5:Verb Id="OpenZipCompressEach"
                             Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1B02" />
              <desktop5:Verb Id="OpenZipCompressPrompt"
                             Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1B03" />
            </desktop5:ItemType>
            <!-- Folders: compress leaves -->
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="OpenZipCompressBundle"
                             Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1B01" />
              <desktop5:Verb Id="OpenZipCompressEach"
                             Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1B02" />
              <desktop5:Verb Id="OpenZipCompressPrompt"
                             Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F1B03" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>

        <!-- Command-line execution alias: enables `openzip` from any cmd/PS shell.
             Windows synthesises a stub at %LOCALAPPDATA%\Microsoft\WindowsApps\openzip.exe
             which is on the user's PATH by default (Win10 1809+). -->
        <uap3:Extension Category="windows.appExecutionAlias"
                        Executable="openzip.exe"
                        EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="openzip.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>

        <!-- Classic Win10 context menu handler (IContextMenu / Win11 21H2+ manifest registration) -->
        <desktop9:Extension Category="windows.fileExplorerClassicContextMenuHandler">
          <desktop9:FileExplorerClassicContextMenuHandler>
            <desktop9:ExtensionHandler Type="*"
                                       Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F2000" />
            <desktop9:ExtensionHandler Type=".zip"
                                       Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F2000" />
            <desktop9:ExtensionHandler Type=".gz"
                                       Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F2000" />
            <desktop9:ExtensionHandler Type=".tgz"
                                       Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F2000" />
            <desktop9:ExtensionHandler Type=".taz"
                                       Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F2000" />
            <desktop9:ExtensionHandler Type=".xz"
                                       Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F2000" />
            <desktop9:ExtensionHandler Type=".txz"
                                       Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F2000" />
            <desktop9:ExtensionHandler Type="Directory"
                                       Clsid="A8F3C7E4-1B2D-4F5E-9C8A-3B6D2E5F2000" />
          </desktop9:FileExplorerClassicContextMenuHandler>
        </desktop9:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
